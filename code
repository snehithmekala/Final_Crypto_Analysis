import requests
from bs4 import BeautifulSoup
import pandas as pd
import time
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry


# ============================================================
# CONFIGURATION
# ============================================================

BASE_URL = "https://coinmarketcap.com/?page={}"

OUTPUT_CSV = "crypto_Analysis_Data_Task5.csv"
OUTPUT_XLSX = "crypto_Analysis_Data_Task5.xlsx"

TOTAL_PAGES = 20


# ============================================================
# REQUEST SESSION WITH RETRIES
# ============================================================

session = requests.Session()

retry_strategy = Retry(
    total=3,
    backoff_factor=1,
    status_forcelist=[429, 500, 502, 503, 504],
    allowed_methods=["GET"]
)

adapter = HTTPAdapter(max_retries=retry_strategy)
session.mount("https://", adapter)
session.mount("http://", adapter)

headers = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/120.0 Safari/537.36"
    )
}


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def convert_number(value):
    """
    Convert values such as:
    1.5K -> 1500
    2.3M -> 2300000
    4.2B -> 4200000000
    1.1T -> 1100000000000
    """
    if value is None:
        return None

    value = value.strip().replace(",", "").replace("$", "")

    if value in {"", "-", "N/A"}:
        return None

    try:
        multiplier = 1

        if value[-1].upper() == "K":
            multiplier = 1_000
            value = value[:-1]

        elif value[-1].upper() == "M":
            multiplier = 1_000_000
            value = value[:-1]

        elif value[-1].upper() == "B":
            multiplier = 1_000_000_000
            value = value[:-1]

        elif value[-1].upper() == "T":
            multiplier = 1_000_000_000_000
            value = value[:-1]

        return float(value) * multiplier

    except ValueError:
        return None


def convert_price(value):
    """
    Convert cryptocurrency price text to float.
    Handles $, commas and very small decimal values.
    """
    if value is None:
        return None

    value = value.strip().replace("$", "").replace(",", "")

    if value in {"", "-", "N/A"}:
        return None

    try:
        return float(value)
    except ValueError:
        return None


def convert_percentage(value):
    """
    Convert percentage text such as:
    5.57% -> 5.57
    -2.31% -> -2.31
    """
    if value is None:
        return None

    value = value.strip().replace("%", "").replace(",", "")

    if value in {"", "-", "N/A"}:
        return None

    try:
        return float(value)
    except ValueError:
        return None


# ============================================================
# SCRAPING
# ============================================================

all_data = []
seen_coins = set()

for page in range(1, TOTAL_PAGES + 1):

    url = BASE_URL.format(page)

    print(f"Scraping page {page}/{TOTAL_PAGES}...")

    try:
        response = session.get(
            url,
            headers=headers,
            timeout=20
        )

        response.raise_for_status()

    except requests.RequestException as e:
        print(f"Error loading page {page}: {e}")
        continue

    soup = BeautifulSoup(response.text, "html.parser")

    rows = soup.find_all("tr")

    page_count = 0

    for row in rows:

        tds = row.find_all("td")

        # Skip rows that do not contain coin information
        if len(tds) < 10:
            continue

        try:

            # ------------------------------------------------
            # COIN NAME
            # ------------------------------------------------
            name_tag = tds[2].find(
                ["p", "a", "span"]
            )

            if name_tag:
                coin_name = name_tag.get_text(strip=True)
            else:
                coin_name = tds[2].get_text(strip=True)

            # Skip blank names
            if not coin_name:
                continue

            # Remove duplicates
            if coin_name in seen_coins:
                continue

            # ------------------------------------------------
            # SYMBOL
            # ------------------------------------------------
            symbol = ""

            # Try common symbol elements
            symbol_tag = row.find(
                "p",
                class_=lambda x: x and "coin-item-symbol" in x
            )

            if symbol_tag:
                symbol = symbol_tag.get_text(strip=True)

            # Fallback
            if not symbol:
                texts = tds[2].stripped_strings
                texts = list(texts)

                if len(texts) > 1:
                    symbol = texts[-1]

            # ------------------------------------------------
            # PRICE
            # ------------------------------------------------
            price = convert_price(
                tds[3].get_text(strip=True)
            )

            # ------------------------------------------------
            # 1H CHANGE
            # ------------------------------------------------
            change_1h = convert_percentage(
                tds[4].get_text(strip=True)
            )

            # ------------------------------------------------
            # 24H CHANGE
            # ------------------------------------------------
            change_24h = convert_percentage(
                tds[5].get_text(strip=True)
            )

            # ------------------------------------------------
            # 7D CHANGE
            # ------------------------------------------------
            change_7d = convert_percentage(
                tds[6].get_text(strip=True)
            )

            # ------------------------------------------------
            # MARKET CAP
            # ------------------------------------------------
            market_cap = convert_number(
                tds[7].get_text(strip=True)
            )

            # ------------------------------------------------
            # VOLUME 24H
            # ------------------------------------------------
            volume_24h = convert_number(
                tds[8].get_text(strip=True)
            )

            # ------------------------------------------------
            # CIRCULATING SUPPLY
            # ------------------------------------------------
            supply_text = tds[9].get_text(strip=True)

            circulating_supply = convert_number(
                supply_text.split()[0]
            )

            # ------------------------------------------------
            # STORE RECORD
            # ------------------------------------------------
            record = {
                "Coin Name": coin_name,
                "Symbol": symbol,
                "Price (USD)": price,
                "1h Change (%)": change_1h,
                "24h Change (%)": change_24h,
                "7d Change (%)": change_7d,
                "Market Cap": market_cap,
                "Volume (24h)": volume_24h,
                "Circulating Supply": circulating_supply
            }

            all_data.append(record)
            seen_coins.add(coin_name)

            page_count += 1

        except Exception as e:
            print(
                f"Skipping a row on page {page}: {e}"
            )
            continue

    print(
        f"Page {page}: {page_count} new coins collected"
    )

    # Small delay between requests
    time.sleep(1)


# ============================================================
# CREATE DATAFRAME
# ============================================================

df = pd.DataFrame(all_data)

# Remove duplicate coins if any
df = df.drop_duplicates(
    subset=["Coin Name"]
).reset_index(drop=True)


# ============================================================
# DISPLAY SUMMARY
# ============================================================

print("\n========================================")
print("SCRAPING COMPLETED")
print("========================================")

print(f"Total coins collected: {len(df)}")

print("\nColumns:")
print(df.columns.tolist())

print("\nFirst 5 rows:")
print(df.head())


# ============================================================
# SAVE CSV
# ============================================================

df.to_csv(
    OUTPUT_CSV,
    index=False
)

print(f"\nCSV saved as: {OUTPUT_CSV}")


# ============================================================
# SAVE EXCEL
# ============================================================

df.to_excel(
    OUTPUT_XLSX,
    index=False
)

print(f"Excel saved as: {OUTPUT_XLSX}")


# ============================================================
# FINAL VALIDATION
# ============================================================

required_columns = [
    "Coin Name",
    "Symbol",
    "Price (USD)",
    "1h Change (%)",
    "24h Change (%)",
    "7d Change (%)",
    "Market Cap",
    "Volume (24h)",
    "Circulating Supply"
]

missing_columns = [
    col for col in required_columns
    if col not in df.columns
]

if missing_columns:
    print(
        "\nWARNING: Missing columns:",
        missing_columns
    )
else:
    print(
        "\nAll required columns are present."
    )

print("\nMissing values:")
print(df[required_columns].isnull().sum())

print("\n========================================")
print("DONE")
print("========================================")
